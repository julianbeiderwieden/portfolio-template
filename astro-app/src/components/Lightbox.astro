---
/** Enlarges every <Figure zoomable /> on the page. Render once per page. */
import IconButton from './IconButton.astro';

// The images sit on a strip that slides sideways with a swipe: the current one, its two neighbors, and two spares,
// so turns in quick succession never have to reuse an image that is still sliding or fading out.
const slots = 5;
---

<dialog
  class="fixed inset-0 m-0 size-full max-h-none max-w-none cursor-zoom-out overflow-hidden bg-transparent p-0 text-foreground backdrop:bg-transparent"
  aria-label="Image viewer"
  data-lightbox
>
  <div class="absolute inset-0 bg-background opacity-0" data-lightbox-backdrop></div>
  <div class="absolute inset-0" data-lightbox-track>
    {
      Array.from({ length: slots }, () => (
        <div class="absolute inset-0 transition-fade motion-reduce:transition-none" data-lightbox-slot>
          <div
            class="absolute origin-top-left bg-placeholder bg-(image:--lqip) bg-cover has-[[data-lightbox-full][data-loaded]]:bg-none"
            data-lightbox-frame
          >
            <img class="absolute inset-0 size-full" alt="" data-lightbox-preview />
            <img
              class="absolute inset-0 size-full opacity-0 transition-opacity duration-200 data-loaded:opacity-100"
              alt=""
              decoding="async"
              data-lightbox-full
            />
          </div>
          <p class="absolute text-meta text-muted transition-opacity duration-150" hidden data-lightbox-caption />
        </div>
      ))
    }
  </div>
  <div
    class="pointer-events-none absolute inset-[env(safe-area-inset-top)_env(safe-area-inset-right)_env(safe-area-inset-bottom)_env(safe-area-inset-left)]"
    data-lightbox-ui
  >
    {/* The area the enlarged image is fitted into, clear of the controls. */}
    <div class="absolute inset-x-4 inset-y-18 md:inset-x-20 md:inset-y-5" data-lightbox-stage></div>
    <IconButton
      icon="close"
      label="Close"
      class="pointer-events-auto absolute top-4 right-4 md:top-5 md:right-5"
      data-lightbox-control
      data-lightbox-close
    />
    {/* Anchored to the viewport edges, so they stay put whatever the image's aspect ratio. */}
    <IconButton
      icon="previous"
      label="Previous image"
      class="pointer-events-auto absolute bottom-4 left-4 md:top-1/2 md:bottom-auto md:left-5 md:-translate-y-1/2"
      data-lightbox-control
      data-lightbox-prev
    />
    <IconButton
      icon="next"
      label="Next image"
      class="pointer-events-auto absolute right-4 bottom-4 md:top-1/2 md:right-5 md:bottom-auto md:-translate-y-1/2"
      data-lightbox-control
      data-lightbox-next
    />
    <p class="sr-only" aria-live="polite" data-lightbox-status></p>
  </div>
</dialog>

<script>
  type Rect = { left: number; top: number; width: number; height: number };

  type Slot = {
    el: HTMLElement;
    frame: HTMLElement;
    preview: HTMLImageElement;
    full: HTMLImageElement;
    caption: HTMLElement;
    /** Position on the strip, counted from the image the lightbox opened with; unset while unused. */
    pos?: number;
    target: Rect;
    /** Fading out after the buttons or arrow keys turned on, over the current image's place. */
    fading?: boolean;
  };

  // iOS-like curve: fast start for instant feedback, long soft landing.
  const EASE = 'cubic-bezier(0.32, 0.72, 0, 1)';
  // How much faster than its average speed a slide with EASE starts: the curve's initial slope.
  const EASE_START_SPEED = 0.72 / 0.32;
  const OPEN_MS = 400;
  const CLOSE_MS = 300;
  // Reduced motion: crossfade only, no movement.
  const FADE_MS = 200;
  // Zooming in or out, springing back after a drag that didn't close, settling a strip that was let go.
  const SETTLE_MS = 300;
  // The buttons and arrow keys don't slide: the new image fades in over the old one like in the slideshow, with its
  // utility (transition-fade in global.css, 450ms).
  const CROSSFADE_MS = 450;
  // Held arrow keys repeat about every 30ms; a few crossfades at once are plenty.
  const REPEAT_MS = 120;
  // After a swipe, the slide takes as long as keeps the finger's speed, within these bounds.
  const SWIPE_MIN_MS = 240;
  const SWIPE_MAX_MS = 520;
  // A swipe turns to the next image past this share of the width (capped in px), or as a flick (px per ms).
  const PAGE_DISTANCE = 0.25;
  const PAGE_MAX_DISTANCE = 120;
  const PAGE_VELOCITY = 0.3;
  // Shorter swipes may still end in a click, so they never flick.
  const FLICK_MIN_DISTANCE = 20;
  // Space between image and caption, as in Figure (mt-2).
  const CAPTION_GAP = 8;
  // Zooming that adds less than this isn't worth it; such images close on click instead.
  const MIN_ZOOM = 1.25;
  const MAX_ZOOM = 4;
  // Dragging the image down closes it past this distance, or as a quick flick (px per ms) past the minimum.
  const DISMISS_DISTANCE = 120;
  const DISMISS_MIN_DISTANCE = 30;
  const DISMISS_VELOCITY = 0.11;
  // Movement that makes a touch a drag rather than a tap.
  const DRAG_THRESHOLD = 8;

  const transition = (duration: number, ...properties: string[]) =>
    properties.map(property => `${property} ${duration}ms ${EASE}`).join(', ');

  /** Transform that makes an element laid out at `to` appear at `from` (origin top left). */
  const flip = (from: Rect, to: Rect) =>
    `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`;

  let teardown: (() => void) | undefined;

  function setup() {
    teardown?.();
    teardown = undefined;

    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]')].flatMap(trigger => {
      const thumb = trigger.querySelector('img');
      const caption = trigger.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
      return thumb ? [{ trigger, thumb, caption }] : [];
    });
    if (!dialog || items.length === 0) return;

    const part = <T extends Element = HTMLElement>(name: string, parent: ParentNode = dialog) =>
      parent.querySelector<T>(`[data-lightbox-${name}]`)!;
    const backdrop = part('backdrop');
    const track = part('track');
    const ui = part('ui');
    const stage = part('stage');
    const status = part('status');
    const prev = part<HTMLButtonElement>('prev');
    const next = part<HTMLButtonElement>('next');
    const slots: Slot[] = [...dialog.querySelectorAll<HTMLElement>('[data-lightbox-slot]')].map(el => ({
      el,
      frame: part('frame', el),
      preview: part<HTMLImageElement>('preview', el),
      full: part<HTMLImageElement>('full', el),
      caption: part('caption', el),
      target: { left: 0, top: 0, width: 0, height: 0 },
    }));
    const captions = slots.map(slot => slot.caption);
    const fullTemplate = slots[0].full.cloneNode() as HTMLImageElement;
    const root = document.documentElement;

    let state: 'closed' | 'opening' | 'open' | 'closing' = 'closed';
    /** The image the lightbox opened with: strip positions count from it. */
    let start = 0;
    /** The strip position shown, or being slid to, and the image there. */
    let view = 0;
    let current = 0;
    /** One image's share of the strip: the viewport's width. */
    let pageWidth = innerWidth;
    let sliding = false;
    let slideTimer: number | undefined;
    let fadeTimer: number | undefined;
    let lastCrossfade = 0;
    let morph = true;
    let closeTimer: number | undefined;
    /** Zoomed in: the scale, and where the image's top left corner sits in the viewport. */
    let zoom: { scale: number; x: number; y: number } | undefined;
    let zoomedAt = 0;
    /**
     * A touch in progress: where it started, where the strip was, and once it moved, along which axis (or panning
     * the zoom). The last 100ms of positions give the speed when it lets go.
     */
    let gesture:
      | {
          x: number;
          y: number;
          time: number;
          stripX: number;
          samples: { x: number; t: number }[];
          axis?: 'x' | 'y';
          pan?: { x: number; y: number };
        }
      | undefined;
    /** A drag can still end in a click; ignore clicks until then. */
    let ignoreClicksUntil = 0;
    const controller = new AbortController();
    const { signal } = controller;

    prev.hidden = next.hidden = items.length < 2;

    const itemAt = (pos: number) => (((start + pos) % items.length) + items.length) % items.length;
    const slotAt = (pos: number) => slots.find(slot => slot.pos === pos);
    const currentSlot = () => slotAt(view)!;
    /** The strip's resting place for the current image. */
    const restX = () => -view * pageWidth;
    /** Where the strip is right now, mid-slide included. */
    function stripX() {
      const transform = getComputedStyle(track).transform;
      return transform === 'none' ? 0 : new DOMMatrixReadOnly(transform).m41;
    }

    /**
     * Largest rect with the image's aspect ratio that fits the stage, never past its original size.
     * `reserve` keeps that much height free below it; the image and that space are centered together.
     */
    function fit(thumb: HTMLImageElement, reserve = 0): Rect {
      const area = stage.getBoundingClientRect();
      const areaHeight = Math.max(0, area.height - reserve);
      const naturalWidth = Number(thumb.getAttribute('width'));
      const naturalHeight = Number(thumb.getAttribute('height'));
      const ratio =
        naturalWidth && naturalHeight ? naturalWidth / naturalHeight : thumb.offsetWidth / thumb.offsetHeight;
      const width = Math.min(area.width, areaHeight * ratio, naturalWidth || Infinity);
      const height = width / ratio;
      return { left: area.left + (area.width - width) / 2, top: area.top + (areaHeight - height) / 2, width, height };
    }

    /** Puts the image at strip position `pos` into `slot`: the loaded thumbnail at once, the sharp file on top. */
    function setContent(slot: Slot, pos: number) {
      const { trigger, thumb, caption: text } = items[itemAt(pos)];
      slot.pos = pos;
      slot.el.hidden = false;
      slot.el.style.transform = `translateX(${pos * pageWidth}px)`;
      slot.fading = false;
      slot.el.style.transition = 'none';
      slot.el.style.opacity = slot.el.style.pointerEvents = '';
      slot.frame.style.transition = 'none';
      slot.frame.style.transform = slot.frame.style.opacity = '';
      slot.caption.style.removeProperty('transition');
      slot.caption.style.opacity = '';
      slot.caption.textContent = text;
      slot.caption.hidden = !text;
      if (!thumb.currentSrc) slot.preview.removeAttribute('src');
      else if (slot.preview.src !== thumb.currentSrc) slot.preview.src = thumb.currentSrc;
      // The page's blurred preview, only while there is no loaded file to show (and gone once the sharp one is in).
      slot.frame.style.setProperty('--lqip', thumb.currentSrc ? '' : trigger.style.getPropertyValue('--lqip'));

      // A fresh element, so a stale load can't reveal the wrong image and `load` fires even when cached.
      const image = fullTemplate.cloneNode() as HTMLImageElement;
      image.alt = thumb.alt;
      image.addEventListener('load', () => image.toggleAttribute('data-loaded', true), { once: true });
      slot.full.replaceWith(image);
      slot.full = image;
    }

    /** Fits a slot's image with its caption below, wrapped to the image's width like on the page. */
    function layoutSlot(slot: Slot) {
      const { thumb, caption: text } = items[itemAt(slot.pos!)];
      let target = fit(thumb);

      // A taller caption shrinks the image, which narrows the caption again: settle in a few passes.
      let reserve = 0;
      for (let pass = 0; text && pass < 3; pass++) {
        slot.caption.style.width = `${target.width}px`;
        const height = slot.caption.offsetHeight + CAPTION_GAP;
        if (height === reserve) break;
        reserve = height;
        target = fit(thumb, reserve);
      }

      slot.target = target;
      slot.frame.style.left = `${target.left}px`;
      slot.frame.style.top = `${target.top}px`;
      slot.frame.style.width = `${target.width}px`;
      slot.frame.style.height = `${target.height}px`;
      slot.caption.style.left = `${target.left}px`;
      slot.caption.style.top = `${target.top + target.height + CAPTION_GAP}px`;
      slot.caption.style.width = `${target.width}px`;

      // The sharp file for the fitted width, asked for again with a larger one when the window grows.
      slot.full.sizes = `${Math.ceil(target.width)}px`;
      if (!slot.full.getAttribute('src')) {
        slot.full.srcset = thumb.srcset;
        slot.full.src = thumb.src;
      }
    }

    /**
     * Fills the positions around `view` into slots, reusing ones that are neither needed, on screen at `x`, nor still
     * fading out.
     */
    function fillSlots(x: number) {
      const needed = items.length > 1 ? [view - 1, view, view + 1] : [view];
      const busy = (slot: Slot) => slot.fading || needed.includes(slot.pos!) || Math.abs(slot.pos! + x / pageWidth) < 1;
      for (const pos of needed) {
        if (slotAt(pos)) continue;
        const spare =
          slots.find(slot => slot.pos === undefined) ??
          slots.find(slot => !busy(slot)) ??
          // Only when turns come in very quick succession: the one farthest away.
          slots
            .filter(slot => !needed.includes(slot.pos!))
            .sort((a, b) => Math.abs(b.pos! - view) - Math.abs(a.pos! - view))[0];
        setContent(spare, pos);
        layoutSlot(spare);
      }
      // Screen readers get the current image only.
      for (const slot of slots) slot.el.setAttribute('aria-hidden', String(slot.pos !== view));
    }

    /** Makes the image at `view` the current one. */
    function setCurrent({ scroll }: { scroll: boolean }) {
      items[current].trigger.style.visibility = '';
      current = itemAt(view);
      const { trigger, thumb, caption: text } = items[current];
      // Scroll the page behind the backdrop to this image, so closing lands on it.
      const rect = thumb.getBoundingClientRect();
      if (scroll && (rect.top < 0 || rect.bottom > innerHeight)) {
        thumb.scrollIntoView({ block: 'center', behavior: 'instant' });
      }
      if (morph) trigger.style.visibility = 'hidden';
      // Lets a slideshow switch to the slide holding this image.
      document.dispatchEvent(new CustomEvent('lightbox:change', { detail: { trigger } }));
      const description = [thumb.alt, text].filter(Boolean).join('. ');
      status.textContent = `Image ${current + 1} of ${items.length}${description ? `: ${description}` : ''}`;
      updateCursor();
    }

    /** Slides the strip to `view`. Transitions retarget, so this also carries on from mid-slide or a drag. */
    function slide(duration: number) {
      clearTimeout(slideTimer);
      sliding = duration > 0;
      track.style.transition = sliding ? transition(duration, 'transform') : 'none';
      track.style.transform = `translateX(${restX()}px)`;
      if (sliding) slideTimer = window.setTimeout(() => (sliding = false), duration);
    }

    /** Puts the strip at `x` directly: following a finger, or caught mid-slide. */
    function moveStrip(x: number) {
      track.style.transition = 'none';
      track.style.transform = `translateX(${x}px)`;
    }

    /** Swipes: turns to the next or previous image, sliding on from wherever the strip is at `x`. */
    function turn(step: 1 | -1, x: number, duration: number) {
      zoomOut(false);
      view += step;
      fillSlots(x);
      setCurrent({ scroll: true });
      slide(duration);
    }

    /**
     * Buttons and arrow keys: the strip jumps to the new image, and the old one stays over its place, fading out while
     * the new one fades in, like the slideshow. Opacity transitions retarget, so presses in quick succession blend on.
     */
    function go(step: 1 | -1) {
      if (state !== 'open' || items.length < 2) return;
      const now = performance.now();
      if (now - lastCrossfade < REPEAT_MS) return;
      lastCrossfade = now;

      zoomOut(false);
      const previous = currentSlot();
      view += step;
      fillSlots(restX());
      setCurrent({ scroll: true });
      slide(0);

      const incoming = currentSlot();
      previous.fading = true;
      // A slot that was fading out already carries on from its opacity; any other starts from transparent.
      if (!incoming.fading) {
        incoming.el.style.transition = 'none';
        incoming.el.style.opacity = '0';
        incoming.el.getBoundingClientRect(); // Commit, so the fade-in runs.
      }
      incoming.fading = false;
      incoming.el.style.transform = `translateX(${view * pageWidth}px)`;
      incoming.el.style.pointerEvents = '';
      incoming.el.style.removeProperty('transition');
      incoming.el.style.opacity = '1';
      for (const slot of slots) {
        if (!slot.fading) continue;
        // Over the new image's place, and out of the way of clicks on it.
        slot.el.style.transform = `translateX(${view * pageWidth}px)`;
        slot.el.style.pointerEvents = 'none';
        slot.el.style.removeProperty('transition');
        slot.el.style.opacity = '0';
      }
      clearTimeout(fadeTimer);
      fadeTimer = window.setTimeout(settleFades, CROSSFADE_MS);
    }

    /** Ends crossfades at once: faded slots back to their places on the strip, the current image fully shown. */
    function settleFades() {
      clearTimeout(fadeTimer);
      for (const slot of slots) {
        if (slot.pos === undefined || (!slot.fading && slot.pos !== view)) continue;
        slot.fading = false;
        slot.el.style.transition = 'none';
        slot.el.style.opacity = slot.el.style.pointerEvents = '';
        slot.el.style.transform = `translateX(${slot.pos * pageWidth}px)`;
      }
    }

    /** How far the current image can grow before it turns soft: to its original width, at most the largest file. */
    function zoomScale() {
      const { thumb } = items[current];
      const files = [...thumb.srcset.matchAll(/(\d+)w/g)].map(match => Number(match[1]));
      const largest = Math.min(Number(thumb.getAttribute('width')) || Infinity, Math.max(...files, 0) || Infinity);
      return Math.min(largest / currentSlot().target.width, MAX_ZOOM);
    }

    const canZoom = () => zoomScale() >= MIN_ZOOM;

    function updateCursor() {
      currentSlot().frame.style.cursor = zoom ? 'zoom-out' : canZoom() ? 'zoom-in' : '';
    }

    function applyZoom() {
      if (!zoom) return;
      const { frame, target } = currentSlot();
      frame.style.transform = `translate(${zoom.x - target.left}px, ${zoom.y - target.top}px) scale(${zoom.scale})`;
    }

    /** Keeps the zoomed image covering the viewport, or centered along an axis where it is smaller. */
    function clampZoom() {
      if (!zoom) return;
      const { target } = currentSlot();
      const width = target.width * zoom.scale;
      const height = target.height * zoom.scale;
      zoom.x = width > innerWidth ? Math.min(0, Math.max(innerWidth - width, zoom.x)) : (innerWidth - width) / 2;
      zoom.y = height > innerHeight ? Math.min(0, Math.max(innerHeight - height, zoom.y)) : (innerHeight - height) / 2;
    }

    /** The pointer's position across the viewport picks the part of the image shown: left edge, left side. */
    function panTo(clientX: number, clientY: number) {
      if (!zoom) return;
      const { target } = currentSlot();
      zoom.x = (innerWidth - target.width * zoom.scale) * (clientX / innerWidth);
      zoom.y = (innerHeight - target.height * zoom.scale) * (clientY / innerHeight);
      clampZoom();
      applyZoom();
    }

    function zoomIn(clientX: number, clientY: number) {
      const { frame, full, caption, target } = currentSlot();
      zoom = { scale: zoomScale(), x: 0, y: 0 };
      zoomedAt = performance.now();
      full.sizes = `${Math.ceil(target.width * zoom.scale)}px`; // Fetches a sharper file where there is one.
      frame.style.transition = transition(SETTLE_MS, 'transform');
      caption.style.removeProperty('transition');
      caption.style.opacity = '0';
      panTo(clientX, clientY);
      updateCursor();
    }

    function zoomOut(animate = true) {
      if (!zoom) return;
      zoom = undefined;
      const { frame, caption } = currentSlot();
      frame.style.transition = animate ? transition(SETTLE_MS, 'transform') : 'none';
      frame.style.transform = '';
      caption.style.removeProperty('transition');
      caption.style.opacity = '';
      updateCursor();
    }

    function lockScroll() {
      // Pad by the scrollbar's width so hiding it doesn't shift the page. Not scrollbar-gutter:
      // a stable gutter shrinks vw, and with it the vw-based font size.
      const scrollbarWidth = innerWidth - root.clientWidth;
      if (scrollbarWidth > 0) root.style.paddingRight = `${scrollbarWidth}px`;
      root.style.overflow = 'hidden';
    }

    function unlockScroll() {
      root.style.removeProperty('overflow');
      root.style.removeProperty('padding-right');
    }

    async function open(index: number) {
      if (state !== 'closed') return;
      state = 'opening';
      start = index;
      view = 0;
      // Slots from last time stay hidden until filled again.
      for (const slot of slots) {
        slot.pos = undefined;
        slot.el.hidden = true;
      }
      const slot = slots[0];
      setContent(slot, 0);
      await slot.preview.decode().catch(() => {});
      if (state !== 'opening') return;

      morph = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      const from = items[index].thumb.getBoundingClientRect();
      lockScroll();
      dialog!.showModal();
      pageWidth = dialog!.clientWidth;
      slide(0);
      layoutSlot(slot);
      fillSlots(0);
      setCurrent({ scroll: false });

      // Start exactly on top of the thumbnail, then grow into place.
      const chrome = [ui, ...captions];
      slot.frame.style.transition = backdrop.style.transition = 'none';
      for (const el of chrome) el.style.transition = 'none';
      backdrop.style.opacity = '0';
      for (const el of chrome) el.style.opacity = '0';
      if (morph) slot.frame.style.transform = flip(from, slot.target);
      else slot.frame.style.opacity = '0';
      slot.frame.getBoundingClientRect(); // Commit the start state so the change below transitions.

      const duration = morph ? OPEN_MS : FADE_MS;
      slot.frame.style.transition = transition(duration, 'transform', 'opacity');
      backdrop.style.transition = transition(duration, 'opacity');
      for (const el of chrome) el.style.transition = transition(duration, 'opacity');
      slot.frame.style.transform = slot.frame.style.opacity = '';
      backdrop.style.opacity = '1';
      for (const el of chrome) el.style.opacity = '1';
      state = 'open';
    }

    function close() {
      if (state !== 'open') return;
      settleFades();
      state = 'closing';
      zoom = undefined;
      const { frame, target } = currentSlot();
      const duration = morph ? CLOSE_MS : FADE_MS;

      // Mid-slide, the strip finishes sliding to rest alongside, and the image sliding out fades away.
      slide(morph && Math.abs(stripX() - restX()) > 0.5 ? duration : 0);
      for (const slot of slots) {
        if (slot.frame === frame) continue;
        slot.frame.style.transition = transition(duration, 'opacity');
        slot.frame.style.opacity = '0';
      }

      // Transitions retarget from wherever the image is: mid-opening, zoomed in or dragged down.
      frame.style.transition = transition(duration, 'transform', 'opacity');
      backdrop.style.transition = transition(duration, 'opacity');
      for (const el of [ui, ...captions]) {
        el.style.transition = transition(Math.min(duration, 150), 'opacity');
        el.style.opacity = '0';
      }
      if (morph) frame.style.transform = flip(items[current].thumb.getBoundingClientRect(), target);
      else frame.style.opacity = '0';
      backdrop.style.opacity = '0';
      closeTimer = window.setTimeout(finish, duration);
    }

    function finish() {
      clearTimeout(closeTimer);
      clearTimeout(slideTimer);
      clearTimeout(fadeTimer);
      if (state === 'closed') return;
      const wasShown = state !== 'opening';
      state = 'closed';
      zoom = undefined;
      gesture = undefined;
      sliding = false;

      const { trigger } = items[current];
      trigger.style.visibility = '';
      if (dialog!.open) dialog!.close();
      unlockScroll();
      for (const el of [backdrop, ui, track]) el.style.removeProperty('transition');
      backdrop.style.opacity = ui.style.opacity = track.style.transform = '';
      for (const slot of slots) {
        slot.fading = false;
        slot.el.style.removeProperty('transition');
        slot.el.style.opacity = slot.el.style.pointerEvents = '';
        slot.frame.style.removeProperty('transition');
        slot.frame.style.transform = slot.frame.style.opacity = '';
        slot.caption.style.removeProperty('transition');
        slot.caption.style.opacity = '';
      }
      if (wasShown) trigger.focus({ preventScroll: true });
      document.dispatchEvent(new CustomEvent('lightbox:change', { detail: {} }));
    }

    /** After a drag down that didn't close: back into place. */
    function springBack() {
      const { frame, caption } = currentSlot();
      frame.style.transition = transition(SETTLE_MS, 'transform');
      backdrop.style.transition = ui.style.transition = caption.style.transition = transition(SETTLE_MS, 'opacity');
      frame.style.transform = '';
      backdrop.style.opacity = ui.style.opacity = caption.style.opacity = '1';
    }

    /** A sideways drag let go: on to the next or previous image, or back. */
    function release(touch: NonNullable<typeof gesture>, clientX: number) {
      const first = touch.samples[0];
      const last = touch.samples[touch.samples.length - 1];
      const velocity = last.t > first.t ? (last.x - first.x) / (last.t - first.t) : 0;
      const dx = clientX - touch.x;
      const x = stripX();

      // The direction the finger meant: a flick decides, otherwise the distance dragged.
      const threshold = Math.min(pageWidth * PAGE_DISTANCE, PAGE_MAX_DISTANCE);
      const flick = Math.abs(dx) >= FLICK_MIN_DISTANCE && Math.abs(velocity) > PAGE_VELOCITY;
      const intent = flick ? -Math.sign(velocity) : Math.abs(dx) > threshold ? -Math.sign(dx) : 0;
      // The image in that direction from where the strip is now. Pulling back from a half-shown neighbor lands on
      // the current image rather than the one beyond; no intent lands on the nearest.
      const position = -x / pageWidth;
      const destination =
        intent > 0 ? Math.floor(position) + 1 : intent < 0 ? Math.ceil(position) - 1 : Math.round(position);
      const step = items.length > 1 ? Math.max(-1, Math.min(1, destination - view)) : 0;
      if (!step) return slide(SETTLE_MS);

      // Keep the finger's speed: an EASE slide starts EASE_START_SPEED times faster than its average.
      const remaining = Math.abs(-(view + step) * pageWidth - x);
      const speed = Math.max(0, -step * velocity);
      const matched = speed > 0 ? (EASE_START_SPEED * remaining) / speed : Infinity;
      const duration = Math.min(SWIPE_MAX_MS, Math.max(SWIPE_MIN_MS, matched));
      turn(step as 1 | -1, x, morph ? duration : Math.min(duration, FADE_MS));
    }

    items.forEach(({ trigger }, index) => trigger.addEventListener('click', () => open(index), { signal }));
    prev.addEventListener('click', () => go(-1), { signal });
    next.addEventListener('click', () => go(1), { signal });
    part('close').addEventListener('click', close, { signal });

    // A click on the image zooms in and out where it can; anywhere else outside the controls closes.
    dialog.addEventListener(
      'click',
      event => {
        const element = event.target as Element;
        if (
          state !== 'open' ||
          sliding ||
          element.closest('[data-lightbox-control]') ||
          performance.now() < ignoreClicksUntil
        ) {
          return;
        }
        const onImage = currentSlot().frame.contains(element);
        if (onImage && zoom) zoomOut();
        else if (onImage && canZoom()) zoomIn(event.clientX, event.clientY);
        else close();
      },
      { signal },
    );
    dialog.addEventListener(
      'pointermove',
      event => {
        if (!zoom || event.pointerType !== 'mouse') return;
        // Glide along with the zoom-in, then follow the pointer directly.
        if (performance.now() - zoomedAt > SETTLE_MS) currentSlot().frame.style.transition = 'none';
        panTo(event.clientX, event.clientY);
      },
      { signal },
    );
    dialog.addEventListener(
      'keydown',
      event => {
        if (event.key === 'ArrowLeft') go(-1);
        else if (event.key === 'ArrowRight') go(1);
        else return;
        event.preventDefault();
      },
      { signal },
    );
    // Escape: animate out instead of the dialog's instant close.
    dialog.addEventListener(
      'cancel',
      event => {
        event.preventDefault();
        close();
      },
      { signal },
    );
    // The browser can still force the dialog shut; restore the page if it does.
    dialog.addEventListener('close', finish, { signal });

    // Touch: drag sideways to the next image, drag down to close, or move around in the image while zoomed in.
    dialog.addEventListener(
      'touchstart',
      event => {
        // A second finger ends a drag: put things back rather than leave them half dragged or caught mid-slide.
        if (gesture?.axis === 'y' && !zoom) springBack();
        if (gesture && gesture.axis !== 'y' && !zoom && Math.abs(stripX() - restX()) > 0.5) slide(SETTLE_MS);
        // Taps on the buttons are theirs: they mustn't catch the strip mid-slide.
        if ((event.target as Element).closest('[data-lightbox-control]')) {
          gesture = undefined;
          return;
        }
        // A touch on the image ends a crossfade, so a swipe starts from the strip in place.
        if (state === 'open') settleFades();
        const touch = event.touches.length === 1 ? event.touches[0] : undefined;
        // A second finger means pinch-zoom, which the browser handles.
        if (!touch || state !== 'open' || (visualViewport?.scale ?? 1) > 1) {
          gesture = undefined;
          return;
        }

        // Catch the strip where it is, mid-slide included; it goes on from the image nearest that point.
        const x = stripX();
        if (sliding) {
          clearTimeout(slideTimer);
          sliding = false;
          moveStrip(x);
          const nearest = Math.round(-x / pageWidth);
          if (nearest !== view) {
            view = nearest;
            fillSlots(x);
            setCurrent({ scroll: true });
          }
        }
        gesture = {
          x: touch.clientX,
          y: touch.clientY,
          time: event.timeStamp,
          stripX: x,
          samples: [{ x: touch.clientX, t: event.timeStamp }],
          pan: zoom && { x: zoom.x, y: zoom.y },
        };
      },
      { signal, passive: true },
    );
    dialog.addEventListener(
      'touchmove',
      event => {
        if (!gesture || event.touches.length !== 1) return;
        const touch = event.touches[0];
        const dx = touch.clientX - gesture.x;
        const dy = touch.clientY - gesture.y;
        if (!gesture.axis && Math.max(Math.abs(dx), Math.abs(dy)) > DRAG_THRESHOLD) {
          gesture.axis = Math.abs(dy) > Math.abs(dx) ? 'y' : 'x';
          // Dragging down works from rest only: a strip caught mid-slide settles first.
          if (gesture.axis === 'y' && !zoom && Math.abs(gesture.stripX - restX()) > 0.5) {
            slide(SETTLE_MS);
            gesture = undefined;
            return;
          }
        }

        if (zoom && gesture.pan) {
          event.preventDefault();
          currentSlot().frame.style.transition = 'none';
          zoom.x = gesture.pan.x + dx;
          zoom.y = gesture.pan.y + dy;
          clampZoom();
          applyZoom();
          return;
        }

        if (gesture.axis === 'x') {
          event.preventDefault();
          // The strip follows the finger, at most one image from the current one, where the neighbors are filled.
          // A single image has nowhere to go: resistance.
          const x =
            items.length > 1
              ? Math.max(restX() - pageWidth, Math.min(restX() + pageWidth, gesture.stripX + dx))
              : gesture.stripX + Math.sign(dx) * Math.sqrt(Math.abs(dx)) * 3;
          moveStrip(x);
          gesture.samples.push({ x: touch.clientX, t: event.timeStamp });
          while (gesture.samples.length > 2 && event.timeStamp - gesture.samples[0].t > 100) gesture.samples.shift();
          return;
        }
        if (gesture.axis !== 'y') return;

        event.preventDefault();
        // Down follows the finger; up meets growing resistance instead of a hard stop.
        const { frame, caption } = currentSlot();
        const offset = dy > 0 ? dy : -Math.sqrt(-dy) * 3;
        const progress = Math.min(1, Math.max(0, dy) / (innerHeight / 2));
        frame.style.transition = backdrop.style.transition = ui.style.transition = caption.style.transition = 'none';
        frame.style.transform = `translateY(${offset}px)`;
        backdrop.style.opacity = String(1 - progress);
        ui.style.opacity = caption.style.opacity = String(Math.max(0, 1 - progress * 2));
      },
      { signal, passive: false },
    );
    dialog.addEventListener(
      'touchend',
      event => {
        const touch = gesture;
        gesture = undefined;
        if (!touch) return;
        const end = event.changedTouches[0];
        // A tap on a strip caught mid-slide: let it settle.
        if (!touch.axis) {
          if (Math.abs(stripX() - restX()) > 0.5) slide(SETTLE_MS);
          return;
        }
        ignoreClicksUntil = performance.now() + 400;
        if (zoom) return;
        if (touch.axis === 'x') {
          // The speed at release counts the last 100ms only, so a finger that stopped before lifting doesn't flick.
          touch.samples.push({ x: end.clientX, t: event.timeStamp });
          while (touch.samples.length > 2 && event.timeStamp - touch.samples[0].t > 100) touch.samples.shift();
          return release(touch, end.clientX);
        }

        const dy = end.clientY - touch.y;
        const velocity = dy / (event.timeStamp - touch.time);
        const dismissed = dy > DISMISS_DISTANCE || (dy > DISMISS_MIN_DISTANCE && velocity > DISMISS_VELOCITY);
        if (dismissed) close();
        else springBack();
      },
      { signal },
    );
    dialog.addEventListener(
      'touchcancel',
      () => {
        if (gesture?.axis === 'y' && !zoom) springBack();
        if (gesture && gesture.axis !== 'y' && !zoom && Math.abs(stripX() - restX()) > 0.5) slide(SETTLE_MS);
        gesture = undefined;
      },
      { signal },
    );

    window.addEventListener(
      'resize',
      () => {
        if (state !== 'open') return;
        settleFades();
        zoomOut(false);
        pageWidth = dialog!.clientWidth;
        for (const slot of slots) {
          if (slot.pos === undefined) continue;
          slot.el.style.transform = `translateX(${slot.pos * pageWidth}px)`;
          layoutSlot(slot);
        }
        slide(0);
        updateCursor();
      },
      { signal },
    );

    teardown = () => {
      finish();
      controller.abort();
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = undefined;
  });
</script>
