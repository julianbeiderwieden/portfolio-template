---
import Layout from '../layouts/Layout.astro';
import PortableText from '../components/PortableText.astro';
import { getAbout } from '../utils/sanity';
import { contentText, richText } from '../utils/ui';

const about = await getAbout();
const body = about?.text?.length ? about.text : undefined;
---

<Layout title={about?.seoTitle ?? 'About'} description={about?.seoDescription}>
  {
    body ? (
      <PortableText value={body} class={richText} />
    ) : (
      <p class:list={[contentText, 'text-muted']}>This page has no content yet.</p>
    )
  }
</Layout>
