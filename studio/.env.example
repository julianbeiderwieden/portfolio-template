# Copy to .env and enter your Sanity project ID (sanity.io/manage → your project).
# Use the same values as in astro-app/.env.
SANITY_STUDIO_PROJECT_ID=abc123de
SANITY_STUDIO_DATASET=production

# Optional, for `npm run deploy --workspace=studio`:
# the hostname for https://<hostname>.sanity.studio, so the first deploy doesn't ask for it,
# SANITY_STUDIO_STUDIO_HOST=
# and the app ID the CLI prints after the first deploy, so later deploys update the same Studio.
# SANITY_STUDIO_APP_ID=
